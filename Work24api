"""
고용24 OPEN-API → CSV (부산진구·사하구·부산 전체, 취업·진로 파트)

만드는 파일
  work24_programs_busan.csv   : 부산 고용센터 구직자 취업역량 강화프로그램 (앞으로 30일)
  work24_smallgiant.csv       : 부산진구·사하구 강소기업 (인턴·취업 대상 기업 정보)
  work24_card_courses.csv     : 부산진구·사하구 국민내일배움카드 훈련과정 (자격증 지원)
  work24_jobs.csv            : 채용공고 (※ 현재 개인회원 키는 막혀 있음, 아래 설명 참고)

설치: pip install requests python-dotenv
실행: python work24_api.py   (.env 파일이 같은 폴더에 있어야 함)
"""
import csv
import os
import time
import xml.etree.ElementTree as ET
from datetime import date, timedelta

import requests
from dotenv import load_dotenv

load_dotenv()
BASE = "https://www.work24.go.kr/cm/openApi/call/wk/"
TODAY = date.today()

# 공통코드 API로 확인한 지역코드
REGIONS = {"부산진구": "26230", "사하구": "26380"}


def call(endpoint, key_name, **params):
    key = os.getenv(key_name)
    if not key:
        raise SystemExit(f".env에 {key_name}가 없습니다.")
    params.update(authKey=key, returnType="XML")
    r = requests.get(BASE + endpoint, params=params, timeout=30)
    r.raise_for_status()
    time.sleep(0.3)
    root = ET.fromstring(r.content)
    err = root.findtext("error") or root.findtext("message")
    if err and root.findtext("total") is None:
        return root, err
    return root, None


def to_dict(el):
    return {c.tag: (c.text or "").strip() for c in el}


def save(rows, path):
    if not rows:
        print(f"  (저장할 데이터 없음: {path})")
        return
    fields = list(dict.fromkeys(k for r in rows for k in r))
    with open(path, "w", newline="", encoding="utf-8-sig") as f:
        w = csv.DictWriter(f, fieldnames=fields)
        w.writeheader()
        w.writerows(rows)
    print(f"  → {path} ({len(rows)}건)")


# 1) 구직자 취업역량 강화프로그램 — 날짜별 조회 후 부산 고용센터만
def programs(days=30):
    print("[취업역량 강화프로그램]")
    rows = []
    for i in range(days):
        d = (TODAY + timedelta(days=i)).strftime("%Y%m%d")
        page = 1
        while True:
            root, err = call("callOpenApiSvcInfo217L01.do", "WORK24_PROGRAM_KEY",
                             startPage=page, display=100, pgmStdt=d)
            if err:
                break
            items = root.findall("empPgmSchdInvite")
            for it in items:
                row = to_dict(it)
                if "부산" in row.get("orgNm", ""):
                    row.update(분야="취업·진로", 세부분류="취업상담·교육",
                               지원범위="사하구" if "사하" in row["orgNm"] else "부산",
                               출처="고용24 OPEN-API", 수집일=TODAY.isoformat())
                    rows.append(row)
            if len(items) < 100:
                break
            page += 1
    save(rows, "work24_programs_busan.csv")


# 2) 강소기업 — 지역코드로 필터
def small_giants():
    print("[강소기업]")
    rows = []
    for name, code in REGIONS.items():
        page = 1
        while True:
            root, err = call("callOpenApiSvcInfo216L01.do", "WORK24_SMALLGIANT_KEY",
                             startPage=page, display=100, region=code)
            if err:
                print("  오류:", err)
                break
            items = root.findall("smallGiant")
            for it in items:
                row = to_dict(it)
                row.update(분야="취업·진로", 세부분류="채용·인턴(강소기업)",
                           지원범위=name, 출처="고용24 OPEN-API", 수집일=TODAY.isoformat())
                rows.append(row)
            if len(items) < 100:
                break
            page += 1
        print(f"  {name}: 누적 {len(rows)}건")
    save(rows, "work24_smallgiant.csv")


# 3) 국민내일배움카드 훈련과정 — 부산진구·사하구, 오늘 ~ 올해 말 개강 과정
def card_courses():
    print("[국민내일배움카드 훈련과정]")
    rows = []
    for name, code in REGIONS.items():
        page = 1
        while True:
            key = os.getenv("WORK24_HRD_CARD_KEY")
            r = requests.get(
                "https://www.work24.go.kr/cm/openApi/call/hr/callOpenApiSvcInfo310L01.do",
                params=dict(authKey=key, returnType="XML", outType=1,
                            pageNum=page, pageSize=100,
                            srchTraStDt=TODAY.strftime("%Y%m%d"),
                            srchTraEndDt=f"{TODAY.year}1231",
                            sort="ASC", sortCol=2,
                            srchTraArea1="26", srchTraArea2=code),
                timeout=30)
            r.raise_for_status()
            time.sleep(0.3)
            root = ET.fromstring(r.content)
            if root.findtext("error"):
                print("  오류:", root.findtext("error"))
                break
            items = root.findall("srchList/scn_list")
            for it in items:
                d = to_dict(it)
                d.pop("titleIcon", None)
                d.update(과정명=d.get("title", ""), 훈련기관=d.get("subTitle", ""),
                         수강비=d.get("courseMan", ""), 실제훈련비=d.get("realMan", ""),
                         분야="취업·진로", 세부분류="자격증지원(국비훈련)",
                         지원범위=name, 출처="고용24 OPEN-API", 수집일=TODAY.isoformat())
                rows.append(d)
            if len(items) < 100:
                break
            page += 1
        print(f"  {name}: 누적 {len(rows)}건")
    save(rows, "work24_card_courses.csv")


# 4) 채용정보 — 현재 개인회원 키로는 "개인회원은 사용할 수 없는 OPEN-API" 오류
def jobs():
    print("[채용정보]")
    rows = []
    for name, code in REGIONS.items():
        root, err = call("callOpenApiSvcInfo210L01.do", "WORK24_JOB_KEY",
                         callTp="L", startPage=1, display=100, region=code)
        if err:
            print("  오류:", err)
            print("  → 채용정보는 기업/기관 회원 전용입니다. 학교 명의 기관회원으로 재신청 필요.")
            return
        for it in root.findall("wanted"):
            row = to_dict(it)
            row.update(분야="취업·진로", 세부분류="채용공고", 지원범위=name,
                       출처="고용24 OPEN-API", 수집일=TODAY.isoformat())
            rows.append(row)
    save(rows, "work24_jobs.csv")


if __name__ == "__main__":
    programs()
    small_giants()
    card_courses()
    jobs()
