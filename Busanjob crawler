"""
부산일자리정보망(busanjob.net) 채용공고 크롤러
- 기업채용: 부산진구·사하구 근무지 공고 (고용24·사람인·잡코리아·부산시 공고를 모아둔 곳)
- 공공채용: 공공기관·지자체 채용 (잡알리오 등)
- 결과: busanjob_jobs.csv

설치: pip install requests beautifulsoup4
실행: python busanjob_crawler.py
      (부산진구+사하구 약 5,000건 → 10분 정도 걸림. 빨리 테스트하려면 MAX_PAGES를 5로)
"""
import csv
import re
import time
from datetime import date

import requests
from bs4 import BeautifulSoup

BASE = "https://busanjob.net/view.do"
REGIONS = ["부산진구", "사하구"]
MAX_PAGES = 600          # 지역별 최대 페이지 (1페이지 = 12건)
DELAY = 0.5
TODAY = date.today().isoformat()

YOUTH = re.compile(r"신입|경력무관|인턴|청년|대졸|초대졸|학력무관|수습")

s = requests.Session()
s.headers.update({"User-Agent": "Mozilla/5.0 (student capstone project)"})


def fetch(params):
    r = s.get(BASE, params=params, timeout=20)
    r.raise_for_status()
    time.sleep(DELAY)
    return BeautifulSoup(r.text, "html.parser")


def parse_items(soup, board_no):
    rows = []
    for a in soup.select('li a[onclick*="show("]'):
        m = re.search(r"show\('(\d+)'\)", a.get("onclick", ""))
        if not m:
            continue
        pid = m.group(1)
        tit = a.select_one(".tit")
        items = [i.get_text(" ", strip=True) for i in a.select(".stxt .item")]
        org = a.select_one(".batcont")
        prov = a.select_one(".provide-bat")
        prov_cls = [c for c in (prov.get("class", []) if prov else []) if c != "provide-bat"]
        rows.append({
            "id": pid,
            "공고명": tit.get_text(" ", strip=True) if tit else "",
            "기관·회사": org.get_text(" ", strip=True) if org else "",
            "접수기간": items[0] if items else "",
            "조건": " / ".join(items[1:]),
            "정보제공처": prov_cls[0] if prov_cls else "",
            "상세URL": f"{BASE}?pgMode=show&no={board_no}&id={pid}",
        })
    return rows


def crawl(board_no, extra, label):
    out, seen, page = [], set(), 1
    while page <= MAX_PAGES:
        items = parse_items(fetch({"no": board_no, "pageIndex": page, **extra}), board_no)
        new = [i for i in items if i["id"] not in seen]
        if not new:
            break
        for i in new:
            seen.add(i["id"])
        out.extend(new)
        if page % 20 == 0:
            print(f"  {label}: {page}페이지, {len(out)}건")
        page += 1
    print(f"[{label}] {len(out)}건")
    return out


def main():
    rows = []
    for region in REGIONS:
        for r in crawl(1308, {"sw2": region}, f"기업채용-{region}"):
            r.update(구분="기업채용", 지원범위=region)
            rows.append(r)
    for r in crawl(1309, {}, "공공채용"):
        r.update(구분="공공채용", 지원범위="부산/전국(공공)")
        rows.append(r)

    for r in rows:
        r.update(분야="취업·진로", 세부분류="채용공고",
                 청년적합=("Y" if YOUTH.search(r["공고명"] + " " + r["조건"]) else ""),
                 출처="부산일자리정보망", 수집일=TODAY)

    fields = ["id", "분야", "세부분류", "구분", "지원범위", "공고명", "기관·회사",
              "접수기간", "조건", "청년적합", "정보제공처", "상세URL", "출처", "수집일"]
    with open("busanjob_jobs.csv", "w", newline="", encoding="utf-8-sig") as f:
        w = csv.DictWriter(f, fieldnames=fields)
        w.writeheader()
        w.writerows(rows)
    print(f"\n완료: {len(rows)}건 → busanjob_jobs.csv "
          f"(신입·경력무관 등 청년 적합 {sum(r['청년적합']=='Y' for r in rows)}건)")


if __name__ == "__main__":
    main()
