PORT=4000
# Account workflows use one API process and its persistent backend/.local directory.
# No registration SQL or global Auth hook is required in file mode.
REGISTRATION_STATE_DRIVER=file
REGISTRATION_CLEANUP_ENABLED=false
# Existing SMTP credentials must also be configured on the backend (not only Supabase Dashboard).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SUPABASE_URL=
# 서버 전용 키. 절대 프론트 코드나 GitHub에 올리지 않기
SUPABASE_SERVICE_ROLE_KEY=
CLIENT_URL=http://localhost:5173
# 공공데이터포털 인증키(일반 인증키 Decoding). 지도 장소·행사 갱신(npm run sync:culture)에 사용
DATA_GO_API_KEY=
# 온통청년 Open API 인증키. 문화 정책 갱신에 사용
YOUTHCENTER_API_KEY=
# 서버 전용 OpenAI 키. 정책 상세 AI 설명에만 사용하며 프론트 환경변수에 넣지 않기
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# 지도 장소·행사 하루 1회 자동 갱신. 공용 DB 에 쓰므로 운영 서버 한 곳에서만 true
CULTURE_SYNC_ENABLED=false
CULTURE_SYNC_CRON=0 4 * * *
OPENAI_API_KEY=                # AI 비서 Dr.부 (OpenAI). 비워 두면 규칙 기반으로만 답함
OPENAI_MODEL=                  # 사용할 모델명 (팀 확정 후 입력). 키와 모델이 모두 있어야 켜짐

NAVER_CLIENT_ID=               # 네이버 백과사전 검색 API (용어 설명 출처). 비워 두면 사용 안 함
NAVER_CLIENT_SECRET=           # 비밀 키. 절대 커밋하지 않기
ALARM_JOB_ENABLED=false         # 정책 알림(캘린더)을 때가 되면 알림 센터에 넣는 작업. 공용 DB 에 쓰므로 운영 서버 한 곳에서만 true
