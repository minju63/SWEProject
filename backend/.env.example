PORT=4000
SUPABASE_URL=
# 서버 전용 키. 절대 프론트 코드나 GitHub에 올리지 않기
SUPABASE_SERVICE_ROLE_KEY=
CLIENT_URL=http://localhost:5173
# 공공데이터포털 인증키(일반 인증키 Decoding). 지도 장소·행사 갱신(npm run sync:culture)에 사용
DATA_GO_API_KEY=
# 지도 장소·행사 하루 1회 자동 갱신. 공용 DB 에 쓰므로 운영 서버 한 곳에서만 true
CULTURE_SYNC_ENABLED=false
CULTURE_SYNC_CRON=0 4 * * *
